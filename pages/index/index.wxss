/* pages/index/index.wxss */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.app-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: 0.5rpx;
}

.app-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.settings-btn {
  width: 72rpx;
  height: 72rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid var(--border-color);
}

.settings-icon {
  font-size: 34rpx;
}

/* 顶部统计卡片 */
.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.stat-card {
  flex: 1;
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 20rpx 0;
  text-align: center;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
}

.text-primary {
  color: var(--primary-color);
}

.text-danger {
  color: var(--danger-color);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.stat-overdue {
  background: var(--danger-light);
  border-color: #FECACA;
}

/* 分类 Tab */
.tabs-container {
  display: flex;
  background: #E2E8F0;
  padding: 6rpx;
  border-radius: 14rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #64748B;
  font-weight: 500;
  border-radius: 10rpx;
  transition: all 0.2s ease;
}

.tab-active {
  background: #FFFFFF;
  color: var(--primary-color);
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

/* 待办卡片列表 */
.todo-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 140rpx;
}

.todo-card {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  display: flex;
  align-items: center;
}

.todo-done {
  opacity: 0.65;
  background: #F8FAFC;
}

.todo-overdue-card {
  border-left: 8rpx solid var(--danger-color);
}

.check-box-wrap {
  padding: 10rpx;
  margin-right: 12rpx;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #CBD5E1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: bold;
}

.checkbox.checked {
  background: var(--success-color);
  border-color: var(--success-color);
}

.todo-body {
  flex: 1;
  overflow: hidden;
}

.todo-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.todo-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.line-through {
  text-decoration: line-through;
  color: var(--text-light);
}

.badge {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.badge-danger {
  background: var(--danger-light);
  color: var(--danger-color);
}

.badge-warning {
  background: var(--warning-light);
  color: var(--warning-color);
}

.todo-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.todo-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.meta-item {
  font-size: 22rpx;
  color: var(--text-muted);
}

.meta-remind {
  color: #2563EB;
}

.todo-arrow {
  font-size: 36rpx;
  color: #CBD5E1;
  padding-left: 10rpx;
}

/* 空白与加载 */
.loading-box, .empty-box {
  padding: 100rpx 40rpx;
  text-align: center;
  color: var(--text-light);
}

.empty-icon {
  font-size: 70rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-top: 20rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 10rpx;
  line-height: 1.5;
}

/* 浮动添加按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: var(--primary-color);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.45);
  z-index: 100;
}

.fab-icon {
  font-size: 58rpx;
  line-height: 1;
  margin-top: -6rpx;
}
