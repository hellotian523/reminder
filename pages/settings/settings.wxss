/* pages/settings/settings.wxss */
.status-banner {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.banner-active {
  background: #ECFDF5;
  border: 1rpx solid #A7F3D0;
}

.banner-warning {
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
}

.banner-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.banner-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.card-header {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.input-row {
  display: flex;
  align-items: center;
  background: #F1F5F9;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid var(--border-color);
}

.token-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
}

.toggle-eye {
  padding: 0 10rpx;
  font-size: 32rpx;
}

.token-actions {
  margin-top: 20rpx;
}

.btn-test {
  background: #F8FAFC;
  border: 1rpx solid var(--border-color);
  color: var(--primary-color);
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 12rpx;
  padding: 14rpx 0;
  width: 100% !important;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-info {
  flex: 1;
}

.setting-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.setting-sub {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.picker-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
  background: var(--primary-light);
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
}

.guide-card {
  margin-top: 30rpx;
  background: #FAFAFA;
}

.guide-steps {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
}

.step-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #E2E8F0;
  color: #475569;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.step-content {
  font-size: 26rpx;
  color: var(--text-muted);
  line-height: 1.5;
}

.highlight {
  color: var(--primary-color);
  font-weight: 600;
  text-decoration: underline;
}
