<!-- pages/edit/edit.wxml -->
<view class="container">
  <!-- 标题与备注表单卡片 -->
  <view class="card">
    <view class="form-group">
      <view class="form-label">待办事项标题 <text class="required">*</text></view>
      <input 
        class="form-input" 
        placeholder="要做什么？(例如：准备下周述职汇报)" 
        value="{{title}}" 
        maxlength="100"
        bindinput="onTitleInput" 
      />
    </view>

    <view class="form-group">
      <view class="form-label">详细备注 (选填)</view>
      <textarea 
        class="form-textarea" 
        placeholder="添加补充细节、重点注意事项等..." 
        value="{{desc}}" 
        maxlength="500"
        bindinput="onDescInput"
        auto-height
      />
    </view>
  </view>

  <!-- DDL 与提醒时间配置卡片 -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">⏰ 截止时间与提醒设置</text>
    </view>

    <!-- 截止日期 -->
    <view class="picker-row">
      <view class="picker-label">截止日期</view>
      <picker mode="date" value="{{selectedDate}}" start="{{minDate}}" bindchange="onDateChange">
        <view class="picker-val-box">{{selectedDate}} ▾</view>
      </picker>
    </view>

    <!-- 截止具体时刻 -->
    <view class="picker-row">
      <view class="picker-label">截止时刻 (DDL)</view>
      <picker mode="time" value="{{selectedTime}}" bindchange="onTimeChange">
        <view class="picker-val-box">{{selectedTime}} ▾</view>
      </picker>
    </view>

    <!-- 提前预警窗口 -->
    <view class="picker-row">
      <view class="picker-label">提前预警时间</view>
      <picker range="{{remindLabels}}" value="{{remindIndex}}" bindchange="onRemindOffsetChange">
        <view class="picker-val-box highlight-box">{{remindLabels[remindIndex]}} ▾</view>
      </picker>
    </view>

    <!-- 提醒时间预估高亮说明 -->
    <view class="remind-preview">
      <text class="preview-icon">🔔</text>
      <text class="preview-text">将在 <text class="preview-time">{{targetRemindTimeDisplay}}</text> 微信提醒</text>
    </view>
  </view>

  <!-- 操作按钮组 -->
  <button class="btn-primary" bindtap="onSave" loading="{{saving}}">{{isEdit ? '保存修改' : '立即创建待办'}}</button>

  <button class="btn-delete" wx:if="{{isEdit}}" bindtap="onDelete" loading="{{deleting}}">删除此待办</button>
</view>
